{
  "name": "@wisdomousai/astro-creatures",
  "version": "0.1.1",
  "description": "An Astro integration: your content, shown clean with toy robots walking on the window's frame, or played inside a little 3D room with the pages on a monitor.",
  "type": "module",
  "license": "MIT",
  "author": "wisdomousai",
  "homepage": "https://github.com/wisdomousai/creatures-astro-starter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wisdomousai/creatures-astro-starter.git",
    "directory": "packages/astro-creatures"
  },
  "keywords": [
    "astro-integration",
    "astro-component",
    "withastro",
    "astro",
    "theme",
    "threejs",
    "creatures",
    "robots"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./content": "./src/content.ts",
    "./components/*": "./src/components/mdx/*"
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "src",
    "assets"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "astro": "^7.1.3"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/maple-mono": "^5.3.0",
    "@wisdomousai/creatures": "^0.5.0",
    "astro-expressive-code": "^0.44.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "astro": "^7.1.3"
  }
}
